generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ENUMS (19 ENUMS)
// ==========================================

enum RoleName {
  ADMIN
  MANAGER
  CASHIER
  CHEF
  WAITER
  CUSTOMER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  OPEN
  PAYING
  CLOSED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
}

enum DepositStatus {
  PENDING
  PAID
  REFUNDED
}

enum OrderStatus {
  CREATED
  CONFIRMED
  IN_PROGRESS
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  COOKING
  READY
  SERVED
  REJECTED
}

enum StockMovementType {
  IN_RECEIPT
  OUT_COOKING
  WASTE_SPOILED
  ADJUSTMENT
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  VNPAY
  MOMO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
}

enum ForecastType {
  REVENUE
  PROFIT
  DEMAND
}

enum RecommendationType {
  INVENTORY
  MENU
  PRICING
  BUSINESS
  STAFFING
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum AnomalyType {
  REVENUE
  INVENTORY
  CONSUMPTION
  PAYMENT
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  IGNORED
}

// ==========================================
// 2. MODULE 1: AUTH & RBAC (5 TABLES)
// ==========================================

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            RoleName         @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  phone            String            @unique
  email            String?           @unique
  passwordHash     String            @map("password_hash")
  fullName         String            @map("full_name")
  avatarUrl        String?           @map("avatar_url")
  roleId           String            @map("role_id") @db.Uuid
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  role             Role              @relation(fields: [roleId], references: [id])
  refreshTokens    RefreshToken[]
  reservations     Reservation[]
  openedSessions   DiningSession[]   @relation("SessionOpenedBy")
  closedSessions   DiningSession[]   @relation("SessionClosedBy")
  orders           Order[]
  stockReceipts    StockReceipt[]
  stockMovements   StockMovement[]
  bills            Bill[]
  payments         Payment[]
  refunds          Refund[]
  shiftAssignments ShiftAssignment[]
  attendances      Attendance[]
  auditLogs        AuditLog[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// 3. MODULE 2: RESTAURANT SETUP
// ==========================================

model Restaurant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branches    Branch[]

  @@map("restaurants")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  address      String
  phone        String?
  email        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       Table[]
  reservations Reservation[]

  @@map("branches")
}

model Table {
  id             String          @id @default(uuid()) @db.Uuid
  branchId       String?         @map("branch_id") @db.Uuid
  tableNumber    String          @unique @map("table_number")
  floor          Int
  capacity       Int
  status         TableStatus     @default(AVAILABLE)
  qrCodeToken    String          @unique @map("qr_code_token")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reservations   Reservation[]
  diningSessions DiningSession[]

  @@map("tables")
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  menuItems    MenuItem[]

  @@map("categories")
}

model MenuItem {
  id                  String              @id @default(uuid()) @db.Uuid
  categoryId          String              @map("category_id") @db.Uuid
  name                String
  description         String?
  price               Decimal             @db.Decimal(12, 2)
  costPrice           Decimal?            @map("cost_price") @db.Decimal(12, 2)
  imageUrl            String?             @map("image_url")
  isAvailable         Boolean             @default(true) @map("is_available")
  isRecommendable     Boolean             @default(true) @map("is_recommendable")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  category            Category            @relation(fields: [categoryId], references: [id])
  orderItems          OrderItem[]
  recipes             Recipe[]
  dishProfitabilities DishProfitability[]

  @@map("menu_items")
}

// ==========================================
// 4. MODULE 3: DINING SESSIONS & ORDERS (4 TABLES)
// ==========================================

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  branchId        String?           @map("branch_id") @db.Uuid
  guestName       String            @map("guest_name")
  guestPhone      String            @map("guest_phone")
  specialRequest  String?           @map("special_request")
  tableId         String?           @map("table_id") @db.Uuid
  partySize       Int               @map("party_size")
  reservationTime DateTime          @map("reservation_time")
  depositAmount   Decimal           @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  depositStatus   DepositStatus     @default(PENDING) @map("deposit_status")
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        User              @relation(fields: [customerId], references: [id])
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  table           Table?            @relation(fields: [tableId], references: [id])
  diningSession   DiningSession?

  @@map("reservations")
}

model DiningSession {
  id            String        @id @default(uuid()) @db.Uuid
  sessionCode   String        @unique @map("session_code")
  tableId       String        @map("table_id") @db.Uuid
  reservationId String?       @unique @map("reservation_id") @db.Uuid
  openedById    String?       @map("opened_by_id") @db.Uuid
  closedById    String?       @map("closed_by_id") @db.Uuid
  customerCount Int           @default(1) @map("customer_count")
  status        SessionStatus @default(OPEN)
  startTime     DateTime      @default(now()) @map("start_time")
  endTime       DateTime?     @map("end_time")

  table         Table         @relation(fields: [tableId], references: [id])
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  openedBy      User?         @relation("SessionOpenedBy", fields: [openedById], references: [id])
  closedBy      User?         @relation("SessionClosedBy", fields: [closedById], references: [id])
  orders        Order[]
  bills         Bill[]

  @@map("dining_sessions")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderCode   String      @unique @map("order_code")
  sessionId   String      @map("session_id") @db.Uuid
  waiterId    String?     @map("waiter_id") @db.Uuid
  status      OrderStatus @default(CREATED)
  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  session     DiningSession @relation(fields: [sessionId], references: [id])
  waiter      User?         @relation(fields: [waiterId], references: [id])
  orderItems  OrderItem[]

  @@map("orders")
}

model OrderItem {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  menuItemId      String          @map("menu_item_id") @db.Uuid
  quantity        Int             @default(1)
  unitPrice       Decimal         @map("unit_price") @db.Decimal(12, 2)
  costPrice       Decimal         @map("cost_price") @db.Decimal(12, 2)
  notes           String?
  itemStatus      OrderItemStatus @default(PENDING) @map("item_status")
  rejectionReason String?         @map("rejection_reason")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
  stockMovements  StockMovement[]

  @@map("order_items")
}

// ==========================================
// 5. MODULE 4: INVENTORY & BOM (5 TABLES)
// ==========================================

model InventoryItem {
  id                 String               @id @default(uuid()) @db.Uuid
  itemName           String               @map("item_name")
  unit               String
  currentStock       Decimal              @default(0) @map("current_stock") @db.Decimal(12, 3)
  minAlertThreshold  Decimal              @default(0) @map("min_alert_threshold") @db.Decimal(12, 3)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  recipes            Recipe[]
  stockReceiptDetails StockReceiptDetail[]
  stockMovements     StockMovement[]

  @@map("inventory_items")
}

model Recipe {
  id               String        @id @default(uuid()) @db.Uuid
  menuItemId       String        @map("menu_item_id") @db.Uuid
  inventoryItemId  String        @map("inventory_item_id") @db.Uuid
  quantityRequired Decimal       @map("quantity_required") @db.Decimal(12, 3)

  menuItem         MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([menuItemId, inventoryItemId])
  @@map("recipes")
}

model StockReceipt {
  id           String               @id @default(uuid()) @db.Uuid
  receiptCode  String               @unique @map("receipt_code")
  managerId    String               @map("manager_id") @db.Uuid
  supplierName String?              @map("supplier_name")
  totalCost    Decimal              @map("total_cost") @db.Decimal(12, 2)
  createdAt    DateTime             @default(now()) @map("created_at")

  manager      User                 @relation(fields: [managerId], references: [id])
  details      StockReceiptDetail[]

  @@map("stock_receipts")
}

model StockReceiptDetail {
  id              String        @id @default(uuid()) @db.Uuid
  stockReceiptId  String        @map("stock_receipt_id") @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  quantity        Decimal       @db.Decimal(12, 3)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)

  stockReceipt    StockReceipt  @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_receipt_details")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  inventoryItemId String            @map("inventory_item_id") @db.Uuid
  createdById     String?           @map("created_by_id") @db.Uuid
  orderItemId     String?           @map("order_item_id") @db.Uuid
  movementType    StockMovementType @map("movement_type")
  quantity        Decimal           @db.Decimal(12, 3)
  balanceAfter    Decimal           @map("balance_after") @db.Decimal(12, 3)
  note            String?
  createdAt       DateTime          @default(now()) @map("created_at")

  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  createdBy       User?             @relation(fields: [createdById], references: [id])
  orderItem       OrderItem?        @relation(fields: [orderItemId], references: [id])

  @@map("stock_movements")
}

// ==========================================
// 6. MODULE 5: BILLING & PAYMENTS (4 TABLES)
// ==========================================

model Promotion {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  description    String?
  discountPercent Float?   @map("discount_percent")
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?  @map("max_discount") @db.Decimal(12, 2)
  minOrderAmount Decimal?  @map("min_order_amount") @db.Decimal(12, 2)
  isActive       Boolean   @default(true) @map("is_active")
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  bills          Bill[]

  @@map("promotions")
}

model Bill {
  id             String     @id @default(uuid()) @db.Uuid
  billCode       String     @unique @map("bill_code")
  sessionId      String     @map("session_id") @db.Uuid
  cashierId      String     @map("cashier_id") @db.Uuid
  promotionId    String?    @map("promotion_id") @db.Uuid
  subtotalAmount Decimal    @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount    Decimal    @map("final_amount") @db.Decimal(12, 2)
  status         BillStatus @default(UNPAID)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  session        DiningSession @relation(fields: [sessionId], references: [id])
  cashier        User          @relation(fields: [cashierId], references: [id])
  promotion      Promotion?    @relation(fields: [promotionId], references: [id])
  payments       Payment[]

  @@map("bills")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  billId          String        @map("bill_id") @db.Uuid
  cashierId       String        @map("cashier_id") @db.Uuid
  paymentMethod   PaymentMethod @map("payment_method")
  amountPaid      Decimal       @map("amount_paid") @db.Decimal(12, 2)
  changeAmount    Decimal       @default(0) @map("change_amount") @db.Decimal(12, 2)
  transactionCode String?       @map("transaction_code")
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")

  bill            Bill          @relation(fields: [billId], references: [id])
  cashier         User          @relation(fields: [cashierId], references: [id])
  refunds         Refund[]

  @@map("payments")
}

model Refund {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  managerId String   @map("manager_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  reason    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  payment   Payment  @relation(fields: [paymentId], references: [id])
  manager   User     @relation(fields: [managerId], references: [id])

  @@map("refunds")
}

// ==========================================
// 7. MODULE 6: HR, SCHEDULING & AUDIT (4 TABLES)
// ==========================================

model Shift {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  startTime        String            @map("start_time")
  endTime          String            @map("end_time")

  shiftAssignments ShiftAssignment[]

  @@map("shifts")
}

model ShiftAssignment {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  shiftId      String       @map("shift_id") @db.Uuid
  assignedDate DateTime     @map("assigned_date") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id])
  shift        Shift        @relation(fields: [shiftId], references: [id])
  attendances  Attendance[]

  @@unique([userId, shiftId, assignedDate])
  @@map("shift_assignments")
}

model Attendance {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  shiftAssignmentId String           @map("shift_assignment_id") @db.Uuid
  checkInTime       DateTime?        @map("check_in_time")
  checkOutTime      DateTime?        @map("check_out_time")
  gpsLatitude       Float?           @map("gps_latitude")
  gpsLongitude      Float?           @map("gps_longitude")
  status            AttendanceStatus @default(ON_TIME)

  user              User             @relation(fields: [userId], references: [id])
  shiftAssignment   ShiftAssignment  @relation(fields: [shiftAssignmentId], references: [id])

  @@map("attendances")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityName String   @map("entity_name")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values") @db.JsonB
  newValues  Json?    @map("new_values") @db.JsonB
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ==========================================
// 8. MODULE 7: AI ANALYTICS & INSIGHTS (4 TABLES)
// ==========================================

model DishProfitability {
  id                String   @id @default(uuid()) @db.Uuid
  menuItemId        String   @map("menu_item_id") @db.Uuid
  periodStart       DateTime @map("period_start") @db.Date
  periodEnd         DateTime @map("period_end") @db.Date
  totalQuantitySold Int      @map("total_quantity_sold")
  totalRevenue      Decimal  @map("total_revenue") @db.Decimal(12, 2)
  totalCost         Decimal  @map("total_cost") @db.Decimal(12, 2)
  grossProfit       Decimal  @map("gross_profit") @db.Decimal(12, 2)
  profitMargin      Decimal  @map("profit_margin") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  menuItem          MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("dish_profitability")
}

model AiForecast {
  id             String       @id @default(uuid()) @db.Uuid
  forecastType   ForecastType @map("forecast_type")
  targetDate     DateTime     @map("target_date") @db.Date
  predictedValue Decimal      @map("predicted_value") @db.Decimal(12, 2)
  actualValue    Decimal?     @map("actual_value") @db.Decimal(12, 2)
  modelVersion   String       @map("model_version")
  generatedAt    DateTime     @default(now()) @map("generated_at")

  @@map("ai_forecasts")
}

model AiRecommendation {
  id                 String                 @id @default(uuid()) @db.Uuid
  recommendationType RecommendationType     @map("recommendation_type")
  title              String
  description        String                 @db.Text
  priority           RecommendationPriority @default(MEDIUM)
  relatedEntityId    String?                @map("related_entity_id") @db.Uuid
  status             RecommendationStatus   @default(PENDING)
  createdAt          DateTime               @default(now()) @map("created_at")

  @@map("ai_recommendations")
}

model AiAnomaly {
  id             String          @id @default(uuid()) @db.Uuid
  anomalyType    AnomalyType     @map("anomaly_type")
  description    String          @db.Text
  severity       AnomalySeverity
  detectedValue  Decimal         @map("detected_value") @db.Decimal(12, 2)
  expectedValue  Decimal         @map("expected_value") @db.Decimal(12, 2)
  detectedAt     DateTime        @default(now()) @map("detected_at")
  status         AnomalyStatus   @default(OPEN)

  @@map("ai_anomalies")
}
